# Server Configuration
PORT=5000
NODE_ENV=production

# MongoDB Connection String (Atlas or local)
# Set MONGO_URI in Railway environment variables
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.1kmrn4o.mongodb.net/jile_electronics?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.1kmrn4o.mongodb.net/jile_electronics?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters
JWT_EXPIRES_IN=8h

# Allowed Frontend Origins (CORS) - Comma-separated if multiple
CLIENT_URL=https://ecomerce-frorntend.vercel.app,http://localhost:5173

# File uploads directory
UPLOAD_DIR=uploads

# AI Assistant Features (Optional)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ASSISTANT_MODEL=claude-sonnet-5-5
